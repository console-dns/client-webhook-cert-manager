{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "groupName",
    "dnsAPI",
    "service",
    "certManager",
    "secretAccess"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "groupName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "dnsAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout",
        "insecureSkipTLSVerify",
        "caBundleSecretRef"
      ],
      "not": {
        "properties": {
          "insecureSkipTLSVerify": {"const": true},
          "caBundleSecretRef": {
            "properties": {"name": {"minLength": 1}}
          }
        },
        "required": ["insecureSkipTLSVerify", "caBundleSecretRef"]
      },
      "properties": {
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "insecureSkipTLSVerify": {
          "type": "boolean"
        },
        "caBundleSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "targetPort"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "certManager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "serviceAccountName"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secretAccess": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "secretNames"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "secretNames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "updateStrategy": {
      "type": "string",
      "enum": [
        "Recreate",
        "RollingUpdate"
      ]
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    }
  }
}
